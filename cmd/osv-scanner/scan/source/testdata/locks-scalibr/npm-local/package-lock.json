{
  "name": "npm-local-workspace-app",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "npm-local-workspace-app",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "@chat-template/auth": "*",
        "ansi-html": "file:ansi-html-0.0.1.tgz",
        "wrappy": "^1.0.2"
      }
    },
    "packages/auth": {
      "name": "@chat-template/auth",
      "version": "1.0.0"
    },
    "node_modules/@chat-template/auth": {
      "resolved": "packages/auth",
      "link": true
    },
    "node_modules/ansi-html": {
      "version": "0.0.1",
      "resolved": "file:ansi-html-0.0.1.tgz"
    },
    "node_modules/wrappy": {
      "version": "1.0.2",
      "resolved": "https://registry.npmjs.org/wrappy/-/wrappy-1.0.2.tgz"
    }
  }
}
